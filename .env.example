# 默认 Mock 可离线运行，需先启动本机 MongoDB 副本集。
# 网页模型连接在“模型设置”中配置。
# 网页密钥加密存储在数据库，密钥文件在 outputs/.model-settings.key（禁止提交）。
MDT_STORAGE_BACKEND=mongodb
MDT_MONGODB_URI=mongodb://127.0.0.1:27018/?replicaSet=mdt-rs&directConnection=true
MDT_MONGODB_DATABASE=mdt_lab
# 可选：部署时通过环境提供 Fernet 密钥；不设置时使用本地密钥文件。
# MDT_SECRET_KEY=
# 以下为旧 CLI 预留项，网页不读取 OPENAI_*；旧 CLI 的 llm 模式仍未实现。
MDT_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
# G01 联调脚本可用 --env-file .env --api-key-env DEEPSEEK_API_KEY 读取本机配置。
DEEPSEEK_API_KEY=
