{
  "name": "mdt-research-workbench",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint:ui": "node scripts/check-ui-standards.mjs",
